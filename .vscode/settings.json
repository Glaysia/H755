{
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.autocomplete": "default",
  "C_Cpp.intelliSenseCachePath": "${workspaceFolder}\\cache",
  "C_Cpp.intelliSenseCacheSize": 10240,
  "C_Cpp.default.compileCommands": "${workspaceFolder}\\EWARM\\H755_CM4\\compile_commands.json",
  "files.associations": {
    "*.py": "python",
    "*.h": "c",
    "*.c": "c",
    "*.cc": "c++"
  },
  "cmake.cmakePath": "cube-cmake",
  "cmake.configureArgs": [
    "-DCMAKE_COMMAND=cube-cmake"
  ],
  "cmake.preferredGenerators": [
    "Ninja"
  ],
  "stm32cube-ide-clangd.path": "cube",
  "stm32cube-ide-clangd.arguments": [
    "starm-clangd",
    "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-gcc",
    "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/13.3.1+st.9/bin/arm-none-eabi-g++"
  ]
}
